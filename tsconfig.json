{
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "paths": {
      "@libs/design-system": ["./libs/design-system/src/index.ts"],
      "@libs/vite-common": ["./libs/vite-common/src/index.ts"],
      "@libs/events-hub": ["./libs/events-hub/src/index.ts"],
      "@libs/shared-types/*": ["./libs/shared-types/src/*"]
    }
  },
  "include": ["apps/**/*", "libs/**/*", "tools/**/*"]
}
